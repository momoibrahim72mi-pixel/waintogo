# Copia questo file in .env e cambia la password prima di usarlo
POSTGRES_USER=waintogo
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=waintogo

# Indirizzo del database usato da "pnpm dev" (con docker compose l'API usa quello in docker-compose.yml)
DATABASE_URL=postgres://waintogo:cambiami@localhost:5432/waintogo
